---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, localizePath } from '../../utils/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'ar' } }];
}

const { lang } = Astro.params;
---

<BaseLayout lang={lang}>
  <section class="py-xl px-margin">
    <div class="max-w-[600px] mx-auto text-center">
      <h1 class="font-headline-xl text-headline-xl text-primary mb-md">404</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-lg">{t('404.text', lang)}</p>
      <a href={localizePath('/', lang)} class="inline-flex items-center justify-center font-headline-md text-sm md:text-base px-6 py-3 rounded-full hover:shadow-lg hover:-translate-y-0.5 active:scale-95 transition-all duration-200" style="background-color: #E07A5F; color: white;">
        {t('404.cta', lang)}
      </a>
    </div>
  </section>
</BaseLayout>
