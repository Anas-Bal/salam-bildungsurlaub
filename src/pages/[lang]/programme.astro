---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, getLang, localizePath, langPaths } from '../../utils/i18n';
import programs from '../../data/programs.json';

export function getStaticPaths() { return langPaths(); }

const { lang } = Astro.params;
---

<BaseLayout lang={lang}>
  <section class="py-xl px-margin">
    <div class="max-w-[1280px] mx-auto">
      <h1 class="font-headline-xl text-headline-xl text-primary text-center mb-xs">{t('programme.title', lang)}</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant text-center max-w-2xl mx-auto mb-lg">{t('programme.subtitle', lang)}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
        {programs.map((prog) => {
          const content = lang === 'de' ? prog.de : prog.ar;
          return (
            <a
              href={localizePath(`/programme/${prog.slug}`, lang)}
              class="group bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 flex flex-col md:flex-row"
            >
              {prog.image && (
                <div class="h-48 md:h-auto md:w-48 shrink-0 overflow-hidden">
                  <img src={prog.image} alt={content.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
              )}
              <div class="p-md flex-1 flex flex-col justify-between">
                <div>
                  <h2 class="font-headline-md text-headline-md text-primary mb-xs">{content.title}</h2>
                  <p class="font-body-md text-body-md text-on-surface-variant mb-sm">{content.subtitle}</p>
                  <div class="flex flex-wrap gap-x-md gap-y-1 text-sm text-on-surface-variant mb-sm">
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-base">schedule</span>
                      {content.duration}
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-base">location_on</span>
                      {content.location}
                    </span>
                  </div>
                </div>
                <div class="flex justify-between items-center mt-sm">
                  <span class="font-headline-md text-lg font-bold text-primary">{content.price}</span>
                  <span class="text-sm font-semibold text-secondary group-hover:underline">{t('programme.details', lang)}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
